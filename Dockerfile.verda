FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/data/.cache/huggingface \
    MODEL_DIR=/data/models/personaplex \
    NO_TORCH_COMPILE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv \
      libopus0 libsndfile1 nginx ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY moshi /app/moshi
RUN python3 -m pip install --upgrade pip \
    && python3 -m pip install --index-url https://download.pytorch.org/whl/cu124 torch==2.4.1 \
    # Gradio 4 keeps compatibility with PersonaPlex's pinned
    # huggingface-hub<0.25 dependency.
    && python3 -m pip install /app/moshi gradio==4.44.1

COPY runtime/verda /app/runtime/verda
RUN chmod +x /app/runtime/verda/entrypoint.sh

EXPOSE 7860
ENTRYPOINT ["/app/runtime/verda/entrypoint.sh"]
