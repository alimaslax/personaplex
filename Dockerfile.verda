FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/data/.cache/huggingface \
    MODEL_DIR=/data/models/personaplex \
    NO_TORCH_COMPILE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv \
      libopus0 libsndfile1 nginx ca-certificates curl gnupg \
    && curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/jammy.noarmor.gpg \
      -o /usr/share/keyrings/tailscale-archive-keyring.gpg \
    && curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/jammy.tailscale-keyring.list \
      -o /etc/apt/sources.list.d/tailscale.list \
    && apt-get update && apt-get install -y --no-install-recommends tailscale \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY moshi /app/moshi
# Gradio 4 keeps compatibility with PersonaPlex's pinned
# huggingface-hub<0.25 dependency. CUDA 12.8 PyTorch wheels include Blackwell
# kernels; the 12.4 wheel fails with "no kernel image" on RTX PRO 6000 GPUs.
RUN python3 -m pip install --upgrade pip \
    && python3 -m pip install --index-url https://download.pytorch.org/whl/cu128 torch==2.8.0 \
    && python3 -m pip install /app/moshi gradio==4.44.1

COPY runtime/verda /app/runtime/verda
RUN chmod +x /app/runtime/verda/entrypoint.sh

EXPOSE 7860
ENTRYPOINT ["/app/runtime/verda/entrypoint.sh"]
